            name='memory_recovery',
            tools=[lookup],
            capabilities=[
                InterruptThenCompact(max_messages=4, keep_messages=2, preserve_first_user_message=False),
                Memory(store=store),
                DBOSDurability(),
            ],
        )
    
        @DBOS.workflow(name='memory_recovery')
        async def workflow() -> str:
